# ArthSetu Frontend Environment Configuration

# FastAPI Backend Base URL (e.g. http://localhost:8000/api/v1 or production server URL)
VITE_API_URL=http://localhost:8000/api/v1

# WebSockets Server URL for Live Stock Prices & Market Ticker
VITE_WS_URL=ws://localhost:8000/ws

# Toggle Mock Fallback Data (Set to false for strict backend API mode)
VITE_ENABLE_MOCK_FALLBACK=true
